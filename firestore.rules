rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Core primitive helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidAvatarTone(tone) {
      return tone in ['blue', 'sky', 'slate', 'emerald', 'amber'];
    }

    function isValidProvider(provider) {
      return provider in ['google', 'password'];
    }

    function isValidPhotoUrl(url) {
      return url is string
        && url.size() <= 500
        && (url.size() == 0 || url.matches('^https://.+'));
    }

    function isValidUserStudioProfile(data, userId) {
      return data.keys().hasAll([
          'uid',
          'email',
          'displayName',
          'studioName',
          'studioBio',
          'photoURL',
          'avatarTone',
          'onboardingCompleted',
          'onboardingSkippedOptionals',
          'provider',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid',
          'email',
          'displayName',
          'studioName',
          'studioBio',
          'photoURL',
          'avatarTone',
          'onboardingCompleted',
          'onboardingSkippedOptionals',
          'provider',
          'createdAt',
          'updatedAt'
        ])
        && data.uid is string
        && isValidId(data.uid)
        && data.uid == request.auth.uid
        && data.uid == userId
        && data.email is string
        && data.email.size() >= 3
        && data.email.size() <= 254
        && data.displayName is string
        && data.displayName.size() >= 2
        && data.displayName.size() <= 80
        && data.studioName is string
        && data.studioName.size() >= 2
        && data.studioName.size() <= 100
        && data.studioBio is string
        && data.studioBio.size() <= 400
        && isValidPhotoUrl(data.photoURL)
        && data.avatarTone is string
        && isValidAvatarTone(data.avatarTone)
        && data.onboardingCompleted is bool
        && data.onboardingSkippedOptionals is bool
        && data.provider is string
        && isValidProvider(data.provider)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidActivityType(t) {
      return t in ['studio_created', 'profile_updated', 'account_verified'];
    }

    function isValidStudioActivity(data, userId) {
      return data.keys().hasAll(['uid', 'type', 'title', 'description', 'createdAt'])
        && data.keys().hasOnly(['uid', 'type', 'title', 'description', 'createdAt'])
        && data.uid is string
        && isValidId(data.uid)
        && data.uid == request.auth.uid
        && data.uid == userId
        && data.type is string
        && isValidActivityType(data.type)
        && data.title is string
        && data.title.size() >= 2
        && data.title.size() <= 120
        && data.description is string
        && data.description.size() <= 240
        && data.createdAt is timestamp;
    }

    // Private studio profile isolated strictly by UID
    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;

      allow create: if isVerifiedUser()
        && isValidId(userId)
        && isOwner(userId)
        && isValidUserStudioProfile(incoming(), userId)
        && incoming().onboardingCompleted == true
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isVerifiedUser()
        && isValidId(userId)
        && isOwner(userId)
        && isValidUserStudioProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().email == existing().email
        && incoming().provider == existing().provider
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && existing().onboardingCompleted == true
        && incoming().onboardingCompleted == true
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName',
          'studioName',
          'studioBio',
          'photoURL',
          'avatarTone',
          'updatedAt'
        ]);

      allow delete: if false;

      // Immutable studio activity records under parent user document
      match /activities/{activityId} {
        allow get: if isValidId(userId)
          && isValidId(activityId)
          && isOwner(userId)
          && exists(/databases/$(database)/documents/users/$(userId))
          && existing().uid == request.auth.uid;

        allow list: if isOwner(userId)
          && resource.data.uid == request.auth.uid;

        allow create: if isVerifiedUser()
          && isValidId(userId)
          && isValidId(activityId)
          && isOwner(userId)
          && isValidStudioActivity(incoming(), userId)
          && incoming().createdAt == request.time
          && exists(/databases/$(database)/documents/users/$(userId));

        allow update, delete: if false;
      }
    }
  }
}
